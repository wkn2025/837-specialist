# X12 files must stay LF-only: validate_9claims.py check 17 fails on any CR,
# so a CRLF checkout on Windows would break the deliverable.
* text eol=lf
*.x12 text eol=lf
*.csv text eol=lf

# The 837P seed is a received production file with CRLF endings, and seeds.py
# pins its sha256 over those exact bytes. Normalizing it to LF would make every
# 837P run refuse with "seed ... hashes to X, profile declares Y" on a fresh
# clone. Generated output is unaffected: the generator always writes LF.
"EDI1/Sample 837P/*.x12" -text

# .docx is a zip. The blanket `* text eol=lf` above would strip CRLF from its
# compressed streams and corrupt it - proven, not assumed. Today's summaries
# happen to contain no CRLF, which is luck, not safety.
*.docx binary
*.pdf binary
*.png binary
