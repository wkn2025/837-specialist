{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    // server/index.ts is run by `node --experimental-strip-types`, which
    // resolves the real file, so its .ts import specifier is required at
    // runtime. tsconfig.server.json rewrites it on the compiled path.
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client", "node"],
    // The EDI2 Validator feature imports through this alias; vite.config.ts
    // carries the matching runtime alias.
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src", "server", "vite.config.ts"]
}
